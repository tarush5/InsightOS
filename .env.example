# ---------------------------------------------------------------------------
# InsightOS environment. Copy to .env and fill in.
# NEVER commit a populated .env. Nothing here is exposed to the browser except
# variables explicitly prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

ENV=local
DEBUG=true

# --- Infrastructure --------------------------------------------------------
# The async driver is selected automatically, so a plain postgresql:// URL works
# here too. asyncpg is used at runtime; aiosqlite backs the test suite.
DATABASE_URL=postgresql+asyncpg://insightos:insightos@localhost:5432/insightos
REDIS_URL=redis://localhost:6379/0

# Where scripts/seed_data.py wrote the demo warehouse. Only the demo provider
# reads this; a real data source is configured per workspace.
SEED_DIR=./seed

# --- Auth ------------------------------------------------------------------
# Required outside local. Generate with: openssl rand -hex 32
AUTH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# OWASP's 2023 floor. Lowering it is refused outside local development.
PASSWORD_HASH_ROUNDS=390000

# Optional. Triggered alerts POST here in addition to the application log.
# Must be https: the alert body names metrics and segments.
ALERT_WEBHOOK_URL=

# Data source credentials are resolved from the environment by reference, never
# stored in the database. A source registered with secret_ref "warehouse" reads:
# INSIGHTOS_SECRET_WAREHOUSE=postgresql+asyncpg://reader:...@host:5432/db

# --- LLM gateway -----------------------------------------------------------
# Leave LLM_PROVIDER=none to run fully offline. Every figure, driver, forecast
# and confidence score is still computed; only narrative prose is templated.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PLANNING_MODEL=claude-sonnet-4-6
LLM_NARRATIVE_MODEL=claude-sonnet-4-6

# --- Query safety ----------------------------------------------------------
SQL_STATEMENT_TIMEOUT_MS=15000
SQL_MAX_RESULT_ROWS=50000
SQL_MAX_JOINS=8
SQL_MAX_QUERY_DEPTH=6

# --- Observability ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=insightos-api
PROMETHEUS_ENABLED=true

# --- Frontend (public) -----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
